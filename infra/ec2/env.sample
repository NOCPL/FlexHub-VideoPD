# Copy to /opt/videopd/.env on the EC2 host.
# ASP.NET Core maps nested keys with a double underscore (__).
# Quote any value that contains spaces (the SQLite connection string does).

# Public URLs — production web is https://videopd.nocpl.in (ALB + ACM).
PublicWebUrl=https://videopd.nocpl.in
Cors__Origins=https://videopd.nocpl.in

# LiveKit (browser talks to the SFU on the instance, not through the ALB).
LiveKit__Url=wss://livekit.nocpl.in
LiveKit__HttpUrl=http://127.0.0.1:7880
LiveKit__ApiKey=visitmeet
LiveKit__ApiSecret=replace_with_32_plus_char_secret

# ASP.NET Core
ASPNETCORE_URLS=http://127.0.0.1:5088
ASPNETCORE_ENVIRONMENT=Production
Jwt__Issuer=VisitMeet
Jwt__Audience=VisitMeet
Jwt__SigningKey=replace_with_a_long_random_signing_key
ConnectionStrings__Default="Data Source=/opt/videopd/data/visitmeet.db"

# Recordings — local disk for first deploy; switch to S3 when keys exist.
Storage__RecordingsPath=/opt/videopd/recordings
Storage__UploadsPath=/opt/videopd/uploads
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# RECORDINGS_S3_BUCKET=visitmeet-recordings

# Next.js. Leave empty so the web origin rewrites /api and /hubs to the API.
# Set only if the API is on another host.
NEXT_PUBLIC_API_URL=
VISITMEET_API_ORIGIN=http://127.0.0.1:5088
