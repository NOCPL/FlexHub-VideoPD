# Copy to /opt/visitmeet/.env on the EC2 host.

# Public URLs
PUBLIC_WEB_URL=https://meet.example.com
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=visitmeet
LIVEKIT_API_SECRET=replace_with_32_plus_char_secret
LIVEKIT_HTTP_URL=http://127.0.0.1:7880

# ASP.NET Core
ASPNETCORE_URLS=http://127.0.0.1:5088
JWT_SIGNING_KEY=replace_with_a_long_random_signing_key
ConnectionStrings__Default=Data Source=/opt/visitmeet/data/visitmeet.db

# Recordings — local disk for first deploy; switch to S3 when keys exist.
RECORDINGS_PATH=/opt/visitmeet/recordings
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# RECORDINGS_S3_BUCKET=visitmeet-recordings
